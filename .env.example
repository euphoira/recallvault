# Default deterministic offline demo needs no API key and sends no network requests.
RECALLVAULT_MODE=demo
RECALLVAULT_DATABASE=.recallvault/memory.db

# For real extraction/assistant tools, choose a Chat Completions tool-capable model.
# Not every OpenAI model supports Chat Completions. No model is selected for you.
# RECALLVAULT_MODE=live
# RECALLVAULT_API_KEY=
# RECALLVAULT_BASE_URL=https://api.openai.com/v1
# RECALLVAULT_MODEL=

# Optional real semantic retrieval. Leave empty for pure BM25.
# Setting this sends memory text + queries to the configured remote embedding endpoint.
# The exact response model ID and vector dimensions must match these values.
# RECALLVAULT_EMBEDDING_MODEL=
# RECALLVAULT_EMBEDDING_DIMENSIONS=1536
